            #8e2945
        );

    color: white;

    font-size: 17px;

    cursor: pointer;

    box-shadow:
        0 8px 20px
        rgba(143, 41, 69, .25);

}


.send-button span {

    margin-left: 18px;
    gap: 12px;

    flex: 1;

}


}


.status {

    position: absolute;

    bottom: 92px;

    left: 50%;

    transform: translateX(-50%);

    padding: 10px 18px;

    border-radius: 20px;

    background: rgba(55, 31, 35, .92);

    color: white;

    opacity: 0;

    pointer-events: none;

    transition: opacity .3s ease;

}


.status.visible {

    opacity: 1    top: 8%;
    right: 8%;
}


.heart-two {

    bottom: 8%;
    left: 7%;

    font-size: 90px;

    animation-delay: -2s;

}


.heart-three {

    top: 35%;
    left: 4%;

    font-size: 45px;

    animation-delay: -3s;

}


/* =========================================================
   ANIMATION
   ========================================================= */

@keyframes floatHeart {

    0%,
    100% {

        transform:
            translateY(0)
            rotate(-5deg);

    }

    50% {

        transform:
            translateY(-18px)
            rotate(5deg);

    }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

    .mail-scene {

        padding: 15px 8px;

    }

    .compose-window {

        border-radius: 14px;

    }

    .compose-header {

        height: 55px;

        padding: 0 17px;

        font-size: 16px;

    }

    .mail-field {

        min-height: 58px;

        padding: 0 17px;

}
</style>

</head>


<body>

    <main class="mail-scene">


        <!-- =================================================
             COMPOSE WINDOW
             ================================================= -->

        <section class="compose-window">


            <!-- TOP BAR -->

            <header class="compose-header">

                <span>
                    New Message
                </span>

                <div class="window-controls">

                    <button type="button">
                        −
                    </button>

                    <button type="button">
                        □
                    </button>

                    <button
                        type="button"
                        class="close-button"
                    >
                        ×
                    </button>

                </div>

            </header>


            <!-- RECIPIENT -->

            <div class="mail-field">

                <label for="recipient">
                    To:
                </label>

                <input
                    id="recipient"
                    type="email"
                    placeholder="sabaraisa71@gmail.com"
                    autocomplete="email"
                >

                <div class="mail-options">
                    Cc&nbsp;&nbsp;Bcc
                </div>

            </div>


            <!-- SUBJECT -->

            <div class="mail-field">

                <label for="subject">
                    Subject:
                </label>

                <input
                    id="subject"
                    type="text"
                    value="A Little Love Letter For You ❤️"
                >

            </div>


            <!-- TOOLBAR -->

            <div class="toolbar">

                <select
                    id="fontSelector"
                    aria-label="Font"
                >

                    <option>
                        Georgia
                    </option>

                    <option>
                        Arial
                    </option>

                    <option>
                        Times New Roman
                    </option>

                </select>


                <button
                    type="button"
                    data-command="bold"
                >
                    <b>B</b>
                </button>

                <button
                    type="button"
                    data-command="italic"
                >
                    <i>I</i>
                </button>

                <button
                    type="button"
                    data-command="underline"
                >
                    <u>U</u>
                </button>

                <button type="button">
                    A
                </button>

                <button type="button">
                    ☰
                </button>

                <button type="button">
                    •☰
                </button>

                <button type="button">
                    ❝
                </button>

                <button type="button">
                    🔗
                </button>

                <button type="button">
                    🖼️
                </button>

                <button type="button">
                    😊
                </button>

                <button type="button">
                    ⋮
                </button>

            </div>


            <!-- MESSAGE -->

            <div
                id="message"
                class="message-editor"
                contenteditable="true"
                spellcheck="true"
            >

                <p>
                    Hey you, ❤️
                </p>

                <p>
                    This isn't just a message.
                    <br>
                    It's a little part of me...
                    <br>
                    A little reminder that you mean
                    more than words can ever explain.
                </p>

                <p>
                    Every little memory with you
                    <br>
                    is my favorite story.
                    <br>

                    Every little moment with you
                    <br>
                    is my favorite place to be.
                </p>

                <p>
                    Thank you for being you.
                    <br>
                    Thank you for being mine.
                </p>

                <p class="signature">
                    You'll always have my heart. 💕
                </p>

            </div>


            <!-- FOOTER -->

            <footer class="compose-footer">

                <button
                    id="sendButton"
                    class="send-button"
                    type="button"
                >
                    Send
                    <span>⌄</span>
                </button>


                <div class="footer-tools">

                    <button type="button">
                        A
                    </button>

                    <button type="button">
                        📎
                    </button>

                    <button type="button">
                        🔗
                    </button>

                    <button type="button">
                        😊
                    </button>

                    <button type="button">
                        🖼️
                    </button>

                    <button type="button">
                        🔒
                    </button>

                    <button type="button">
                        ⋮
                    </button>

                </div>


                <button
                    class="trash-button"
                    type="button"
                >
                    🗑️
                </button>

            </footer>


            <!-- STATUS -->

            <div
                id="status"
                class="status"
                aria-live="polite"
            ></div>


        </section>


        <!-- DECORATION -->

        <div class="scene-heart heart-one">
            ♥
        </div>

        <div class="scene-heart heart-two">
            ♥
        </div>

        <div class="scene-heart heart-three">
            ♥
        </div>

    </main>


    <script src="/app.js"></script>

</body>

</html>
